  .accordion-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: #9ca3af;
    margin-left: 0.75rem;
    flex-shrink: 0;
  }

  .accordion-chevron {
    color: #9ca3af;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .filter-accordion-trigger[aria-expanded="true"] .accordion-chevron {
    transform: rotate(180deg);
  }

  .filter-accordion-panel {
    padding: 0.75rem;
    background: #fff;
  }

  .filter-options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .filter-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
