---
import { getCollection } from 'astro:content';
import SearchBar from '../components/SearchBar.astro';

const entries = await getCollection('assets').catch((error) => {
  console.error('Failed to load assets:', error);
  return [];
});

// Load all images with a static glob pattern (required by Vite)
const imageModules = import.meta.glob<ImageMetadata>('../../assets/media/*.{jpg,jpeg,png,gif,webp}', { eager: true, import: 'default' });

// Only include entries that have a valid image filename
const cards = entries
  .filter((entry) => entry.data?.filename && entry.data.filename[0])
  .map((entry) => {
    const filename = entry.data.filename?.[0];
    const imagePath = `../../assets/media/${filename}`;
    const imageModule = imageModules[imagePath];
    if (!imageModule) return null;
    return {
      id: entry.data.id,
      Title: entry.data.Title,
      Description: entry.data.description ?? '',
      Creator: entry.data.Creator ?? '',
      Contributor: entry.data.Contributor ?? '',
      Institution: entry.data.Institution ?? '',
      Country: entry.data.Country,
      Region: entry.data.Region ?? '',
      Subject: entry.data.Subject ?? '',
      Coverage: entry.data.Coverage ?? '',
      Language: entry.data.Language ?? '',
      Slug: entry.data.slug,
      Image: imageModule,
    };
  })
  .filter((entry) => entry !== null);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Asset Gallery</title>
  </head>
  <body>
    <main class="container">
      <h1>Asset Gallery</h1>

      <SearchBar assets={cards} />

      <nav class="nav">
        <a href="/primary/" class="primary-link">Browse Primary Collection →</a>
      </nav>
    </main>
  </body>
</html>

<style>
  .container {
    max-width: 1200px;
    margin-inline: auto;
    padding: 2rem 1rem 4rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
</style>