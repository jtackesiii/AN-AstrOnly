  {
    "Title": "Jinbaori",
    "Creator": "",
    "Contributor": "Woudenberg, Annie",
    "Institution": "St. Olaf College",
    "Source": "Yoshiaki Shimizu, ed., \"Japan: The Shaping of Daimyo Culture 1185-1868\" Washington: National Gallery of Art, 1988, pl. 265.",
    "Rights": "Materials may be used for educational, non-commercial purposes only.",
    "Subject": "Clothing; Textiles; Historical Figures; Daimyo",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "1573-1615",
    "Type": "Still Image",
    "Dimensions": "1024 w x 817 h, 72 ppi",
    "Collection": "Asian Takeout",
    "id": "4508",
    "filename": [
      "4508-jinbaori.jpg"
    ],
    "description": "This jinbaori, made of wool, is said to have been owned by Date Masamune, daimyo of Sendai.  The jinbaori's purpose was originally functional, being worn over armor for protection against cold and rain.  Horizontally centered on the back of this jacket of thin wool is the bamboo and sparrow crest (\"mon\") of the Date family embroidered in gold."
  },
  {
    "Title": "Japanese Street Scene",
    "Creator": "",
    "Contributor": "Woudenberg, Andrea",
    "Institution": "St. Olaf College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.",
    "Subject": "Cityscapes",
    "Language": "Japanese",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "01/01/2003",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "820 w x 614 h, 300 ppi",
    "Collection": "Asian Takeout",
    "id": "4507",
    "filename": [
      "4507-japanese-street-scene.jpg"
    ],
    "description": "These classically designed Japanese buildings speak of older times.  They could be found in any city in Japan, although these happen to stand on the famous island of Miyajima.  The building in the middle is a restaurant that I ended up eating a fantastic meal of cold ramen, boiled eggs, and fresh vegetables."
  },
  {
    "Title": "Inro and Netsuke",
    "Creator": "Anonymous",
    "Contributor": "Colby College Museum of Art",
    "Institution": "Colby College",
    "Source": "",
    "Rights": " Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "Edo-Tokugawa",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "4506",
    "filename": [
      "4506-inro-and-netsuke.jpg"
    ],
    "description": "Lacquer, mother-of-pearl, and wood. This small inro, a pouch for carrying medicines, coins, and other valuables, takes the form of a rabbit, complete with feet sculpted on the bottom. The netsuke, or toggle for attaching the inro to the belt, is a tortoise whose head retracts inside its body. The pairing of the tortoise and the hare thus evokes the famous fable of Aesop, with which the Japanese would have been familiar in the late Edo and early Meiji periods."
  },
