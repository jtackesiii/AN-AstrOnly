  {
    "Title": "Shrine to local Kami in Garan",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism; Shinto; Architecture",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "34.216667",
    "Longitude": "135.583333",
    "Date": "07/07/2002",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "640 w x 480 h, 72 ppi",
    "Collection": "Japanese Religion Images",
    "id": "4368",
    "filename": [
      "4368-shrine-to-local-kami-in-garan.jpg"
    ],
    "description": "This Shinto-style shrine stands in the heart of the Garan complex and reflects the importance of the traditions of worship dedicated to the \"local\" deity of the mountain. It appears that Kukai revered these \"kami\" deeply and this reverence continues via regular rituals today."
  },
