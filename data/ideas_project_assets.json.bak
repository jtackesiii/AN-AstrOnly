  {
    "Title": "Hiroshima:  Peace Park --  Memorial to children who perished  in the blast, 01",
    "Creator": "",
    "Contributor": "Thiedeman, Michael",
    "Institution": "Earlham College",
    "Source": "",
    "Rights": "Material may be used for educational, non-commercial purposes only, in accordance with Fair Use policies. Acknowledgement to be given to the IDEAS Project, Earlham College, and the Hiroshima Peace Memorial Park. Photographer retains copyright.",
    "Subject": "Monuments; -Hiroshima; Atomic bomb victims",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
