  {
    "Title": "Hasedera - Main entrance",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism; Adults",
