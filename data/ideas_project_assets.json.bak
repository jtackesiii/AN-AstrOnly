  },
  {
    "Title": "Chao Watching Bamboo",
    "Creator": "Pang, Cheng",
    "Contributor": "Flaten Art Museum",
    "Institution": "St Olaf College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Calligraphy; Painting",
    "Language": "Chinese",
    "Country": "China",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "2705",
    "filename": [
      "2705-chao-watching-bamboo.jpg"
    ],
    "description": "16.25 x 20  inches. Painting; Male figure looking up with bamboo in foreground with Chinese script in upper right. The painting shows the scholar Chao, some bamboo, and a calligraphic homage to the scholar. Here, the modern Chinese artist follows in a long and respected tradition of paying homage to a previous painter and poet, and in this way carrying the past into the present. Sometimes, but probably not here, this entails emulating the famous person's own calligraphic style. The sense that the brush, making a stroke on paper, conveys something of the inner spirit of the person holding the brush reappeared in modern Abstract Expressionism."
  },
  {
    "Title": "Town On River",
    "Creator": "Kuniyoshi, Yasuo",
    "Contributor": "Flaten Art Museum",
    "Institution": "St Olaf College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
