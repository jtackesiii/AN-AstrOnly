  {
    "Title": "Sumo throws 1",
    "Creator": "",
    "Contributor": "St. Olaf College",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.",
    "Subject": "Sports And Exercise; Leisure Activities; Sumo",
    "Language": "Japanese",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
