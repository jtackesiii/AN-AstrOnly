  {
    "Title": "Spring Floral Scene with Narcissus at Base of a Garden Rock",
    "Creator": "",
    "Contributor": "Emison Art Museum",
    "Institution": "DePauw University",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Painting",
    "Language": "Chinese, Mandarin, English",
    "Country": "China",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "4576",
    "filename": [
      "4576-spring-floral-scene-with-narcissus-at-base-of-a-ga.jpg"
    ],
    "description": "Watercolor on paper. Label attached on lower left says in English and Chinese \"My Dear Miss Dickshaw, Jang Yun Fang\". Large flowers in pink and white with green leaves and brown limbs are peering up from large dark gray/black rocks while white flowers and green plants are grouped at the left hand side and bottom of the rocks; Japanese characters are on the top right hand side along with a red seal with another seal present under the inscription on the bottom left hand side."
  },
