  {
    "Title": "Jizo statue in forest",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism; Figures; Sculpture",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "34.216667",
    "Longitude": "135.583333",
    "Date": "06/07/2002",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "640 w x 480 h, 72 ppi",
    "Collection": "Japanese Religion Images",
    "id": "1845",
    "filename": [
      "1845-jizo-statue-in-forest.jpg"
    ],
    "description": "One of thousands of statues of Jizo, the merciful deity who is commonly entreated to assist children who have died young, especially even prior to birth.  These statues are often dressed in caps and aprons.  This clothing is sometimes placed there by a bereaved mother, or sometimes by any warm-hearted person who happens to be fond of keeping little Jizo neatly dressed."
  },
