    "id": "2551",
    "filename": [
      "2551-vishnu-and-sridevi.jpg"
    ],
    "description": "Recombined copper alloy figures of Vishnu and Sridevi showing how they would have originally looked as a pair.  Sridevi is the consort of Vishnu."
  },
  {
    "Title": "Presentation Gift Cover (Fukusa)",
    "Creator": "",
    "Contributor": "Mills College Art Museum",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Textiles",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "18th century, Edo-Tokugawa",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "2545",
    "filename": [
      "2545-presentation-gift-cover-fukusa.jpg"
    ],
    "description": "Embroidered satin; 29 inches x 34 inches. Fukusa were decorative rectangular or square panels of lined fabric of various sizes that were used to place atop a gift during presentation. They were not used to wrap an object, but merely as an elaborate accoutrement used in the presentation ceremony. This example depicts five well dressed couples between rows of crops."
  },
  {
    "Title": "Vishnu",
    "Creator": "",
    "Contributor": "Mills College Art Museum",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Sculpture; Hinduism",
