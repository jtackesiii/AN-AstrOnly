    "Subject": "Shinto; Ritual; Figures",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "",
    "Type": "Still Image",
