  {
    "Title": "Koyasan bell",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism; Architecture",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "34.216667",
    "Longitude": "135.583333",
    "Date": "07/07/2002",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "640 w x 480 h, 72 ppi",
    "Collection": "Japanese Religion Images",
    "id": "4356",
    "filename": [
      "4356-koyasan-bell.jpg"
    ],
    "description": "The high roof covers a large bronze bell that is rung hourly. It can be heard throughout the entire town.  When Kukai founded Koyasan in the early ninth century, he sought contributions to build a similar bell and argued that temple bells are a vital part of the community."
  },
  {
    "Title": "Sign along path to the Garan complex",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism",
    "Language": "Japanese",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "34.216667",
    "Longitude": "135.583333",
    "Date": "07/07/2002",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "640 w x 480 h, 72 ppi",
    "Collection": "Japanese Religion Images",
    "id": "4355",
    "filename": [
      "4355-sign-along-path-to-the-garan-complex.jpg"
    ],
    "description": "This long path leads from the Kongobuji temple to the Garan, which is a complex of buildings such as large pagodas and halls for worship. There are several signs like this one in Koyasan (often with their idiosyncratic English renderings) that show support for the town being recognized by UNESCO as a site on their World Heritage List. As of 2003 Japan has ten sites so recognized."
  },
  {
    "Title": "Kongobuji temple",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism; Architecture",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "34.216667",
    "Longitude": "135.583333",
    "Date": "07/07/2002",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "640 w x 480 h, 72 ppi",
    "Collection": "Japanese Religion Images",
    "id": "4349",
    "filename": [
      "4349-kongobuji-temple.jpg"
    ],
    "description": "This temple complex is the headquarters for the Koyasan Shingon denomination. The founder Kukai seems to have built a structure in this location back in the 9th century; the present buiding is only a few centuries old.  Next door to the temple is a cluster of more modern looking buildings that houses the administrative center for the denomination, which has branch temples all throughout Japan."
  },
