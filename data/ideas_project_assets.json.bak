  {
    "Title": "Portrait of Huang Daozhou accompanying painting of Bamboo in Dew, Pine in Wind",
    "Creator": "Jiao Bingzhen",
    "Contributor": "Bowdoin College Museum of Art",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Calligraphy; Painting; Historical Figures",
    "Language": "Chinese",
    "Country": "China",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "Ming",
    "Type": "Still Image",
    "Dimensions": "797 w x 507 h, 72 ppi",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "913",
    "filename": [
      "913-portrait-of-huang-daozhou-accompanying-painting-of.jpg"
    ],
    "description": "This image precedes a very long handscroll that includes an additional series of colophons as well as a title frontispiece. It is historically quite interesting since the artist of the handscroll, Huang Daozhou, was a notable Ming patriot and martyr. His biography is included beside the portrait, which precede the ink bamboo and pine. The authors of the other colophons praise Huang. 103 x 15 1/2 inches."
  },
  {
    "Title": "Bamboo in Dew, Pine in Wind",
    "Creator": "Huang Daozhou, Jiao Bingzhen",
    "Contributor": "Bowdoin College Museum of Art",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Painting",
