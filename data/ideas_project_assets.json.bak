  {
    "Title": "Japanese Woman in Western Dress, Accompanied by a Servant Japanese Garb",
    "Creator": "Ipposai YOSHITORA (?) (fl. c. 1850-80)",
    "Contributor": "Emison Art Museum",
    "Institution": "DePauw University",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Prints",
    "Language": "Punjabi",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "2359",
    "filename": [
      "2359-japanese-woman-in-western-dress-accompanied-by-a-s.jpg"
    ],
    "description": "Presents the contrast between native traditional female garb (worn by the servant girl), and the new European style clothing for women.  The figure in Western garb here, however, still holds a Chinese fan shape decorated with a wave pattern.  Yoshitora was a pupil of leading late Edo period printmaker Utagawa KUNIYOSHI (1797-1861) was a member of the Yokohama School, but he did not reside there, and probably based his designs on the figures he could have seen in Western engravings.  Publisher's seal, with stylized lotus over waves, identifies the publisher as Sakai Kawaguchi."
  },
  {
    "Title": "Sumo Wrestler Defeating a Westerner",
    "Creator": "Ipposai YOSHIFUJI (1828-87)",
    "Contributor": "Emison Art Museum",
    "Institution": "DePauw University",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Prints; Leisure Activities",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "2358",
    "filename": [
      "2358-sumo-wrestler-defeating-a-westerner.jpg"
    ],
    "description": "Image of Sumo wrestler successfully tossing a westerner while man and woman looking on. Japanese characters are written on the top of the print and the lower right side. One of a series of prints that appeared during the time between the arrival of Commodore Matthew Perry in 1853, and the actual beginning of the Meiji Era (1868-1912)."
  },
