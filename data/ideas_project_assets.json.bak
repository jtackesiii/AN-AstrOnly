  },
  {
    "Title": "Pilgrims in front of the Great Pagoda",
    "Creator": "",
    "Contributor": "Gardiner, David L. , 1957-",
    "Institution": "Colorado College",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only.  Acknowledgment to be given to the IDEAS image database and the photographer.  Photographer retains copyright.",
    "Subject": "Sites; Buddhism; Adults; Ritual",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "34.216667",
    "Longitude": "135.583333",
    "Date": "07/07/2002",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "640 w x 480 h, 72 ppi",
    "Collection": "Japanese Religion Images",
    "id": "4358",
    "filename": [
      "4358-pilgrims-in-front-of-the-great-pagoda.jpg"
    ],
    "description": "The Great Pagoda (Daito) is the most striking structure within the Garan complex in the western central part of Koyasan. The pagoda stands over 150 feet tall (48.5 meters). These pilgrims, who travel as a group in their white garb and are accompanied by priests in black robes, pray before the entrance of the pagoda toward the huge Buddha images inside."
  },
