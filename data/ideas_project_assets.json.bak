  },
  {
    "Title": "Ritual Vessel (Jue) - opposite side",
    "Creator": "",
    "Contributor": "Mills College Art Museum",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Sculpture; Ritual",
    "Language": "",
    "Country": "China",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "2546",
    "filename": [
      "2546-ritual-vessel-jue-opposite-side.jpg"
    ],
    "description": "8 inches x 6.5 inches. Opposite side of classical ritual pouring vessel is cast with typical zoomorphic taotie mask design divided by flanges below a border of lappets on the central decorated section. The smoothly patinated surface shows malachite incrustation throughout. This is one of the most recognizable of the archaic bronze forms."
  },
  {
    "Title": "Presentation Gift Cover (Fukusa)",
    "Creator": "",
    "Contributor": "Mills College Art Museum",
    "Institution": "",
    "Source": "",
    "Rights": "Materials may be used for educational, non-commercial purposes only. Acknowledgement to be given to the ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project and to the college from whose collection the work comes. The individual college retains copyright to the work.",
    "Subject": "Arts; Textiles",
    "Language": "",
    "Country": "Japan",
    "Region": "East Asia",
    "Latitude": "",
    "Longitude": "",
    "Date": "",
    "Coverage": "18th century, Edo-Tokugawa",
    "Type": "Still Image",
    "Dimensions": "",
    "Collection": "ASIANetwork-Luce Asian Art in the Undergraduate Curriculum Project",
    "id": "2550",
    "filename": [
      "2550-presentation-gift-cover-fukusa.jpg"
    ],
    "description": "Embroidered silk. Fukusa were decorative rectangular or square panels of lined fabric of various sizes that were used to place atop a gift during presentation. This example depicts a golden Dutch warship under sail with the wind on a calm sea. The ship is rendered in heavy gold couched thread and fine satin stitches. \"Namban\" art, depicting 'southern barbarians' (as the Dutch and the Portuguese were first thought to be by the insular Japanese), was very popular subject matter in Edo period decorative arts.\n\nGift of Mr. Nomura"
  },
